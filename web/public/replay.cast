[19.755564, "o", "                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  54     for (const token of [\"userMessageBg\", \"toolPendingBg\", \"toolSuccessBg\", \"toolErrorBg\"]) \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m{\u001b[39m                                                                                                \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  55       const pair = report.checks.find((check) => check.token === token && check.background  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m=== \"background\");\u001b[39m                                                                               \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  56       assert.equal(pair?.contrast, 3);\u001b[39m                                                      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m     ...\u001b[39m             "]
