[26.224137, "o", "                  \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1m$ ghostty +show-config --default --help 2>&1 | head -55; ghostty +show-config --default 2>&1 | rg  \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[1;38;2;1;2;55m'^(background|foreground|theme|background-opacity|background-blur-radius)\\s*=' | head -40; ghostty \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[1;38;2;1;2;55m+show-config 2>&1 | rg '^(background|foreground|theme|background-opacity)\\s*=' | head -40\u001b[22m\u001b[39m\u001b[38;2;1;2;22m (timeout \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;22m120s)\u001b[39m                                                                                              \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;22m... (26 earlier lines,\u001b[39m \u001b[38;2;1;2;22mctrl+o\u001b[39m\u001b[38;2;1;2;9m"]
[26.224154, "o", " to expand\u001b[39m\u001b[38;2;1;2;22m)\u001b[39m                                                           \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52m    options, especially paired with `--default`.\u001b[39m                                                   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52mtheme = \u001b[39m                                                                                           \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52mbackground = #282c34\u001b[39m                                                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52mforeground = #ffffff\u001b[39m                                                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52mbackground-opacity = 1\u001b[39m                                                                             \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2"]
