[26.2275, "o", " 50     assert.equal(report.summary.required, 168);\u001b[39m                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  51     assert.equal(report.summary.noRequirement, 22);\u001b[39m                                         \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  52     assert.ok(report.checks.every((pair) => pair.passes !== false));\u001b[39m                        \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  53     assert.equal(theme.colors.muted, theme.colors.dim);\u001b[39m                                     \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 54     // Pi's footer renders the cwd and usage/model lines with `dim` on the terminal canvas.\u001b[39m \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 55     for (const token of [\"dim\", \"muted\"]) {\u001b[39m                                                 \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 56 "]
