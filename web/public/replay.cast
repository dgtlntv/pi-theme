[26.224667, "o", "   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 89 test(\"Ghostty's default dark terminal colors satisfy every declared contrast pair\", () => {\u001b[39m \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 90   assert.equal(recipe.terminalBackground.dark, \"#282c34\");\u001b[39m                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 91   const result = generateTheme(recipe, contract, \"dark\", { terminalForeground: \"#ffffff\"    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m});\u001b[39m                                                                                              \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 92   assert.equal(result.report.terminal.foreground.hex, \"#ffffff\");\u001b[39m                           \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 93   assert.ok(result.report.checks.every((pair) => pair.passes !== false));\u001b[39m                   \u001b[49m "]
[26.224677, "o", "\u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 94 });\u001b[39m                                                                                         \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 95 \u001b[39m                                                                                            \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  89 test(\"changing the anchor or hue affects colors; impossible terminal colors fail loudly\",   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m() => {\u001b[39m                                                                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  90   const changedRecipe = structuredClone(recipe);\u001b[39m                                            \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  91   changedRecipe.terminalBackground.dark = \"#151515\";\u001b[39m                                        \u001b[49m \u001b[49m\u001b[0m"]
[26.224685, "o", "\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  92   assert.notEqual(generateTheme(changedRecipe, contract,                                    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m\"dark\").report.selected.toolSuccessBg.step,\u001b[39m                                                      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m     ...\u001b[39m                                                                                         \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m                                                                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1m$ npm test && npm run generate; node - <<'JS'\u001b[22"]
[26.224695, "o", "m                                                      \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1mfor(const m of ['dark','light']){const                                                             \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[1;38;2;1;2;55mr=require(`./generated/generated-pi-${m}.report.json`);console.log(m,r.terminal, r.summary)}\u001b[22m       \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1mJS\u001b[22m\u001b[39m\u001b[38;2;1;2;22m (timeout 120s)\u001b[39m                                                                                  \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;22m... (54 earlier lines,\u001b[39m \u001b[38;2;1;2;22mctrl+o\u001b[39m\u001b[38;2;1;2;9m to expand\u001b[39m\u001b[38;2;1;2;22m)\u001b[39m                                                           \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52m    hex: '#292725',\u001b[39m                                                                             "]
[26.224703, "o", "   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52m    saturation: 0.03965,\u001b[39m                                                                           \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52m    source: 'contrast-derived'\u001b[39m                                                                     \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52m  }\u001b[39m                                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;52m} { required: 167, noRequirement: 23 }\u001b[39m                                                             \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;22mTook 0.0s\u001b[39m                                                                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b["]
[26.224713, "o", "49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n \u001b[1m\u001b[3m\u001b[38;2;1;2;45mAdjusting dark report default\u001b[39m\u001b[23m\u001b[22m                                                                      \u001b[0m\u001b]8;;\u0007\r\r\n                                                                                                    \u001b[0m\u001b]8;;\u0007\r\r\n \u001b[1m\u001b[3m\u001b[38;2;1;2;45mUpdating README background example\u001b[39m\u001b[23m\u001b[22m                                                                 \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m                                                                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1medit\u001b[22m\u001b[39m \u001b]8;;file:///Users/max/Documents/GitHub/pi-theme/README.md\u001b\\\u001b[38;2;1;2;47mREADME.md\u001b[39m\u001b]8;;\u001b\\                                                                                   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2"]
[26.224725, "o", ";1;2;54m                                                                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m    ...\u001b[39m                                                                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 19 Regeneration updates the symlink targets. Because Pi watches its **themes directory**,       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mchanges to files elsewhere via a symlink may not trigger live reload; run `/reload` or restart   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mPi if the active theme does not update. The reference themes still assume the recipe's terminal  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mbackground and a derived terminal foreground; measure/pin your actual terminal colors before     \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mrelying on their con"]
[26.224735, "o", "trast report.\u001b[39m                                                                \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 20 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 21 ## Inputs and algorithm\u001b[39m                                                                      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 22 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50m-23 - **Recipe:** `terminalBackground.dark` and `.light` are the fixed hex anchors. Every other  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mrole is assigned a color family (constant OKHSL hue and min/max saturation) **without a          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mpreferred lightness**. `stepInterv"]
[26.224746, "o", "al` controls search precision, not design preference. Step 0   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mis white, 1000 black. As in `../design-tokens`, saturation follows a normalized Gaussian         \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mcentered at step 500; lightness is `1 - step/1000`.\u001b[39m                                              \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+23 - **Recipe:** `terminalBackground.dark` and `.light` are the fixed hex anchors. \u001b[7mDark is      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[7;38;2;1;2;48m`#282c34`, Ghostty's installed default (`ghostty +show-config --default`); the light value       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[7;38;2;1;2;48m`#f7f6f6` is only a hypothetical light-terminal anchor, **not** a Ghostty default. \u001b[27mEvery other   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mrole is assigned a color family (constant OKHSL hu"]
[26.224758, "o", "e and min/max saturation) **without a          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mpreferred lightness**. `stepInterval` controls search precision, not design preference. Step 0   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mis white, 1000 black. As in `../design-tokens`, saturation follows a normalized Gaussian         \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mcentered at step 500; lightness is `1 - step/1000`.\u001b[39m                                              \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 24 - **Contrast contract:** each relationship has one `contrast` value meaning **at least**     \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mthat WCAG 2.1 ratio. `contrast: null` explicitly means no requirement, and still appears in      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mreports. The same token can have separate ratios on different surfaces—for ex"]
[26.22477, "o", "ample, higher       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49magainst the terminal background and 4.5 on a tool surface.\u001b[39m                                       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 25 - **Selection:** starting from the fixed terminal background, choose surfaces, then          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mforegrounds, then the scrollbar thumb (which depends on the track). Search available steps on    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mthe lighter side for dark mode or darker side for light mode. Accept only final **hex** colors   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mthat satisfy all currently known required pairs. Of the valid steps, choose the one with the     \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49msmallest average excess contrast over its applicable ratios. For a token with only `null`        \u001b[49m \u001b[4"]
[26.224777, "o", "9m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mrequirements, choose the closest *different hex* to the terminal background; it is **not         \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mguaranteed to look visibly different**. A final independent pass audits all 190 pairs (167       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mrequired, 23 unconstrained) and refuses to emit a theme on any failure.\u001b[39m                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 26 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 27 Contrast determines the steps, not manually specified step numbers. Different surfaces may   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mcause a pair to exceed its requested ratio: a shared color cannot always achieve every threshold \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;"]
[26.224787, "o", "2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mexactly. The report contains the selected steps, final hex colors, actual ratios, pass results,  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mand a compact palette containing only used steps.\u001b[39m                                                \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m    ...\u001b[39m                                                                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 29 This is a **greedy** solver: an early valid background choice can obstruct a later           \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mforeground even if a different background choice would work. Such cases fail explicitly; it does \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mnot prove global infeasibility.\u001b[39m                                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54"]
[26.2248, "o", "m \u001b[38;2;1;2;49m 30 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 31 ## Terminal defaults\u001b[39m                                                                         \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 32 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50m-33 `background` and `terminalForeground` are virtual semantic tokens, **not Pi theme JSON       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mfields**. The \u001b[7mterminal\u001b[27m background comes from \u001b[7mthe recipe\u001b[27m; \u001b[7mthe\u001b[27m reference \u001b[7mterminal \u001b[27mforeground is    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mderived from the \u001b[7mcontrast \u001b[27mcontract . Pi JSON cannot set either terminal default. \u001b[7mTherefore       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r"]
[26.224813, "o", "\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[7;38;2;1;2;50mresults are only guaranteed\u001b[27m against \u001b[7mthose assumed colors until you pin the\u001b[27m actual \u001b[7mRGB values\u001b[27m:\u001b[39m    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+33 `background` and `terminalForeground` are virtual semantic tokens, **not Pi theme JSON       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mfields**. The \u001b[7mdark\u001b[27m background comes from \u001b[7mGhostty's installed default `#282c34`\u001b[27m; \u001b[7mGhostty's        \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[7;38;2;1;2;48mdefault foreground is `#ffffff`. The\u001b[27m reference foreground is derived from the contract           \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m\u001b[7m(`#fefefe` for the current dark recipe), not automatically read from Ghostty\u001b[27m. Pi JSON cannot set \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48meither terminal default. \u001b[7mFor a report checked\u001b[27m against \u001b[7mGhostty's\u001b[27m act"]
[26.224823, "o", "ual \u001b[7mdefault foreground, pin   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[7;38;2;1;2;48mit explicitly\u001b[27m:\u001b[39m                                                                                   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 34 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 35 ```sh\u001b[39m                                                                                        \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50m-36 node src/generate.ts --mode dark --terminal-\u001b[7mbg '#040303' --terminal-\u001b[27mfg '#\u001b[7mfcfcfc\u001b[27m' --out       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50m./verified\u001b[39m                                                                                       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+36 node src/generate.ts --mode dark --terminal-fg '"]
[26.224832, "o", "#\u001b[7mffffff\u001b[27m' --out ./verified\u001b[39m                    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 37 ```\u001b[39m                                                                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 38 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50m-39 `--terminal-bg` overrides the recipe anchor for one mode ; `--terminal-fg` pins the measured \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mforeground instead of deriving an assumed one. Neither flag queries or changes the terminal.     \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mInfeasible terminal combinations fail rather than weakening ratios. `--recipe`, `--contract`,    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mand `--out` accept custom paths. Terminal quantization, ANSI i"]
[26.224857, "o", "nverse, and extension-provided     \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mcolors require separate runtime checks.\u001b[39m                                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+39 `--terminal-bg` overrides the recipe anchor for one mode \u001b[7m(if your Ghostty configuration      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[7;38;2;1;2;48mdiffers)\u001b[27m; `--terminal-fg` pins the measured foreground instead of deriving an assumed one.       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mNeither flag queries or changes the terminal. Infeasible terminal combinations fail rather than  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mweakening ratios. `--recipe`, `--contract`, and `--out` accept custom paths. Terminal            \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mquantization, ANSI inverse, and extension-provided colors require separate runti"]
[26.224873, "o", "me checks.\u001b[39m       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 40 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 41 Tool pending/success/error fills each require 3:1 against the terminal background, **not**   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mpairwise 3:1: four colors cannot all have pairwise 3:1 WCAG contrast. That also does not cure    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mstatus conveyed only by color. These limitations are recorded in the contract.\u001b[39m                   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 42 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 43 ## Code map\u001b[39m                                                                          "]
[26.224884, "o", "        \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m    ...\u001b[39m                                                                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m                                                                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n \u001b[1m\u001b[3m\u001b[38;2;1;2;45mPreparing Pair-generation line\u001b[39m\u001b[23m\u001b[22m                                                                     \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m                                                                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1medit\u001b[22m\u001b[39m \u001b]8;;file:///User"]
[26.224904, "o", "s/max/Documents/GitHub/pi-theme/CONTRAST-REQUIREMENTS.md\u001b\\\u001b[38;2;1;2;47mCONTRAST-REQUIREMENTS.md\u001b[39m\u001b]8;;\u001b\\                                                                    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m                                                                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m    ...\u001b[39m                                                                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 51 These are **provisional design requirements**, not a claim that every background is covered  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mby WCAG 1.4.11. Requiring P/G/R each to contrast with D does not guarantee that success,         \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mpending, and failure can be distinguished from **one another**. Requiring all six pairs of       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1"]
[26.224916, "o", ";2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m`{D,P,G,R}` to meet 3:1 is **impossible** with WCAG luminance: four colors in luminance order    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mwould need a ratio of at least `3³=27` between `(L+.05)` extremes, but sRGB permits at most      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m`(1+.05)/(0+.05)=21`. With no additional cues, color-only tool status may still fail WCAG 1.4.1; \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mcontrast alone does not solve that. We can revisit cues/relaxation later. `customMessageBg`      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mremains decorative; its label carries identity.\u001b[39m                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 52 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b"]
[26.224924, "o", "[38;2;1;2;49m 53 ## Pair-generation implemented\u001b[39m                                                               \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 54 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50m-55 [`theme-recipe.json`](theme-recipe.json) defines color-family hues and saturation ranges and \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50manchors the \u001b[7mterminal background for \u001b[27mdark\u001b[7m/\u001b[27mlight \u001b[7mmode\u001b[27m. **It contains no preferred lightness        \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50msteps.** [`src/solve.ts`](src/solve.ts) coordinates relationship expansion, contrast-derived     \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;50mstep selection, and final checks; implementation is in `contract.ts`, `selection.ts`, and        \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54"]
