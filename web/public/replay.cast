[12.377437, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K \u001b[38;2;1;2;38mRegenerating in this repo updates the linked files. If Pi doesn’t hot-reload a changed symlink     \u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K \u001b[38;2;1;2;38mtarget, run \u001b[39m\u001b[38;2;1;2;11m/reload\u001b[39m\u001b[38;2;1;2;38m\u001b[38;2;1;2;38m or restart it. I added the setup commands and that caveat to \u001b[39m\u001b]8;;README.md\u001b\\\u001b[38;2;1;2;16m\u001b[4m\u001b[38;2;1;2;38mREADME.md\u001b[39m\u001b[24m\u001b[39m\u001b]8;;\u001b\\\u001b[38;2;1;2;38m\u001b[38;2;1;2;38m.\u001b[39m        \u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[48;2;1;2;56m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[48;2;1;2;56m \u001b[38;2;1;2;57mfor the background assume the default background from ghostty pls\u001b[39m                                  \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[48;2;1;2;56m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K \u001b[1m\u001b[3m\u001b[38;2;1;2;45mInspecting Ghostty config\u001b[39m\u001b[23m\u001b[22m                                     "]
[12.377451, "o", "                                     \u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[48;2;1;2;53m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m$ command -v ghostty || true; ls -la ~/.config/ghostty 2>/dev/null; printf                         \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[1;38;2;1;2;55m'TERM_PROGRAM=%s\\nGHOSTTY_RESOURCES_DIR=%s\\n' \"${TERM_PROGRAM:-}\" \"${GHOSTTY_RESOURCES_DIR:-}\"; ls \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[1;38;2;1;2;55m-la /Applications/Ghostty.app/Contents/MacOS 2>/dev/null; rg -n                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[1;38;2;1;2;55m'^(theme|background|foreground|background-opacity|config-file)\\s*=' ~/.config/ghostty 2>/dev/null  \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[1;38;2;1;2;55m| head -80\u001b[22m\u001b[39m                                                                                         \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[48;2;1;2;53m"]
