[8.385234, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 44 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+46 test(\"contract validation preserves explicit no-requirement pairs and rejects missing ones\", \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m() => {\u001b[39m                                                                                          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+47   assert.equal(validateContract(contract).noRequirement, 23);\u001b[39m                                \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+48   const pairs = expandRelationships(contract);\u001b[39m                                               \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+49   const selected = pairs.find((pair) => pair.token === \"selectedBg\" && pair.ba"]
