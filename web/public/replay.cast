[19.772076, "o", "                          \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K \u001b[1m\u001b[3m\u001b[38;2;1;2;45mUpdating docs counts\u001b[39m\u001b[23m\u001b[22m                                                                               \u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[48;2;1;2;53m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m$ rg -n '167|23 unconstrained|7|border.*decorative|prefer' README.md CONTRAST-REQUIREMENTS.md |    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[19;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[1;38;2;1;2;55mhead -85; node - <<'JS'\u001b[22m                                                                            \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[20;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1mlet                                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[21;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[1;38;2;1;2;55mc=require('./generated/generated-pi-dark.json').colors;console.log(c.accent,c.border,c.muted,c.dim \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[22;1H\u001b[2"]
[19.772086, "o", "K\u001b[48;2;1;2;53m \u001b[1;38;2;1;2;55m)\u001b[22m                                                                                                  \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[23;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1mJS\u001b[22m\u001b[39m                                                                                                 \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[24;1H\u001b[2K\u001b[48;2;1;2;53m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[32;1H\u001b[2K\u001b[38;2;1;2;9m↑632k ↓97k R26M CH99.5% $7.518 22.7%/1.0M (auto)\u001b[39m\u001b[38;2;1;2;9m                                    (replay) session\u001b[39m\u001b[0m\u001b]8;;\u0007\u001b[29;1H\u001b[?25l\u001b[?2026l"]
[19.79431, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mweakening ratios. `--recipe`, `--contract`, and `--out` accept custom paths. Terminal            \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mquantization, ANSI inverse, and extension-provided colors require separate runtime checks.\u001b[39m       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 40 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 41 Tool pending/success/error fills each require 3:1 against the terminal background, **not**   \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mpairwise 3:1: four colors cannot all have pairwise 3:1 WCAG contrast. That also does not cure    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49mstatus conveyed only by color. These limitations are recorded in the contract.\u001b[39m         "]
[19.794321, "o", "          \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 42 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+43 **Trade-off at Ghostty's default `#282c34`:** a 3:1 tool/user surface must be substantially  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mlighter than the canvas. A shared text token must then be almost white to reach 4.5:1 on that    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48msurface, even if it was intended to look teal or muted on the canvas. For example, Pi's built-in \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mteal `#8abeb7` is about 6.75:1 on the canvas but only about 2.2:1 on the generated success-tool  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mbackground. This is a constraint conflict, not a hue-generator bug. Red"]
[19.794359, "o", "ucing the surface's       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mprovisional 3:1 rule, lowering text contrast, or adding context-specific semantic tokens/code    \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48mchanges would alter that outcome; the generator does not silently relax either requirement.\u001b[39m      \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+44 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 43 ## Code map\u001b[39m                                                                                  \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 44 \u001b[39m                                                                                             \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m 45 - `src/color.ts`: OKHSL bell curv"]
