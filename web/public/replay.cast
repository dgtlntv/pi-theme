[12.170241, "o", "ght; do\u001b[22m                                                                         \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m  target=\"$(pwd)/generated/generated-pi-${mode}.json\"\u001b[22m                                              \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m  link=\"$HOME/.pi/agent/themes/generated-pi-${mode}.json\"\u001b[22m                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m  if [ -L \"$link\" ]; then\u001b[22m                                                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[14;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m    [ \"$(readlink \"$link\")\" = \"$target\" ] || { echo \"Conflicting symlink: $link\" >&2; exit 1; }\u001b[22m    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m  elif [ -e \"$link\" ]; then\u001b[22m                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m    echo \"Existing file, refusing to replace: $link\" >&2; exit 1\u001b"]
[12.170254, "o", "[22m                                   \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m  else\u001b[22m                                                                                             \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m    ln -s \"$target\" \"$link\"\u001b[22m                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[19;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m  fi\u001b[22m                                                                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[20;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1mdone\u001b[22m                                                                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[21;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1mls -l \"$HOME/.pi/agent/themes/generated-pi-dark.json\"                                              \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[22;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[1;38;2;1;2;55m\"$HOME/.pi/agent/themes/generated-pi-light.json\"\u001b[22m                                                   \u001b[49m\u001b[0m\u001b]8;;"]
[12.170308, "o", "\u0007\u001b[23;1H\u001b[2K\u001b[48;2;1;2;53m \u001b[38;2;1;2;55m\u001b[1m\u001b[22m\u001b[39m                                                                                                   \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[24;1H\u001b[2K\u001b[48;2;1;2;53m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[32;1H\u001b[2K\u001b[38;2;1;2;9m↑389k ↓85k R20M CH99.9% $5.579 20.5%/1.0M (auto)\u001b[39m\u001b[38;2;1;2;9m                                    (replay) session\u001b[39m\u001b[0m\u001b]8;;\u0007\u001b[29;1H\u001b[?25l\u001b[?2026l"]
[12.186741, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1m  const name = `generated-pi-${mode}`;\u001b[22m                                                             \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1m  const entry = getAvailableThemesWithPaths().find(theme => theme.name === name);\u001b[22m                  \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[3;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1m  if (!entry?.path) throw new Error(`${name} not found`);\u001b[22m                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1m  const loaded = loadThemeFromPath(entry.path);\u001b[22m                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1m  console.log(name, 'available:', Boolean(entry), 'loaded:', loaded.name);\u001b[22m                         \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1m}\u001b[22m                                                                                                  \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[48;2;1;2;54m \u001b[38;2;1;2;55m\u001b[1mJ"]
