[26.227109, "o", "de)\u001b[39m                                       \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[38;2;1;2;22mTook 0.0s\u001b[39m                                                                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m                                                                                                    \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b]133;A\u0007\u001b[0m\u001b]8;;\u0007\r\r\n \u001b[1m\u001b[3m\u001b[38;2;1;2;45mAdding contrast threshold test\u001b[39m\u001b[23m\u001b[22m                                                                     \u001b[0m\u001b]8;;\u0007\r\r\n                                                                                                    \u001b[0m\u001b]8;;\u0007\r\r\n \u001b[1m\u001b[3m\u001b[38;2;1;2;45mVerifying contrast thresholds\u001b[39m\u001b[23m\u001b[22m                                                                      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n \u001b[38;2;1;2;38mI lowered the user-message and pending/success/error tool backgrounds to \u001b[39m\u001b[1m"]
