[26.22463, "o", "                       \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;48m+ 5   \"terminalBackground\": {\"dark\":\"#\u001b[7m282c34\u001b[27m\",\"light\":\"#f7f6f6\"},\u001b[39m                                \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  6   \"families\": {\u001b[39m                                                                              \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  7     \"neutral\": {\"hue\":67.57,\"saturation\":{\"min\":0.02,\"max\":0.08}},\u001b[39m                           \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  8     \"accent\": {\"hue\":202.43,\"saturation\":{\"min\":0.1,\"max\":0.72}},\u001b[39m                            \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m  9     \"blue\": {\"hue\":231.49,\"saturation\":{\"min\":0.1,\"max\":0.68}},\u001b[39m                              \u001b[49m \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;1;2;54m \u001b[48;2;1;2;54m \u001b[38;2;1;2;49m    ...\u001b[39m                                                              "]
