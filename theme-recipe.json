{
  "name": "generated-pi",
  "description": "Color-family OKHSL hues/saturation and terminal background anchors. Lightness of every other role is derived from contrast relationships.",
  "stepInterval": 5,
  "terminalBackground": {"dark":"#282c34","light":"#f7f6f6"},
  "families": {
    "neutral": {"hue":250,"saturation":{"min":0.02,"max":0.08}},
    "blue": {"hue":231.49,"saturation":{"min":0.1,"max":0.68}},
    "cyan": {"hue":190,"saturation":{"min":0.1,"max":0.74}},
    "green": {"hue":158.68,"saturation":{"min":0.1,"max":0.76}},
    "red": {"hue":20,"saturation":{"min":0.1,"max":0.92}},
    "yellow": {"hue":82.36,"saturation":{"min":0.5,"max":1}},
    "orange": {"hue":52,"saturation":{"min":0.12,"max":0.85}},
    "purple": {"hue":305,"saturation":{"min":0.1,"max":0.7}},
    "violet": {"hue":295,"saturation":{"min":0.2,"max":0.6}},
    "thinkingSlate": {"hue":231.49,"saturation":{"min":0.08,"max":0.2}},
    "thinkingBlue": {"hue":231.49,"saturation":{"min":0.2,"max":0.45}},
    "thinkingPeriwinkle": {"hue":262,"saturation":{"min":0.3,"max":0.6}},
    "thinkingViolet": {"hue":295,"saturation":{"min":0.4,"max":0.75}},
    "thinkingMagenta": {"hue":330,"saturation":{"min":0.5,"max":0.85}},
    "thinkingRed": {"hue":20,"saturation":{"min":0.95,"max":1}}
  },
  "roles": [
    {"tokens":["terminalForeground"],"family":"neutral"},
    {"tokens":["selectedBg","searchMatchBg"],"family":"blue"},
    {"tokens":["userMessageBg"],"family":"blue"},
    {"tokens":["customMessageBg","customMessageLabel"],"family":"purple"},
    {"tokens":["toolPendingBg"],"family":"neutral"},
    {"tokens":["toolSuccessBg"],"family":"green"},
    {"tokens":["toolErrorBg"],"family":"red"},
    {"tokens":["text","userMessageText","customMessageText","toolTitle","syntaxOperator","syntaxPunctuation"],"family":"neutral"},
    {"tokens":["muted","dim","thinkingText","toolOutput","mdLinkUrl","mdQuote","mdQuoteBorder","mdHr","mdCodeBlockBorder","toolDiffContext","syntaxComment","scrollbarTrack"],"family":"neutral"},
    {"tokens":["scrollbarThumb","searchMatchText"],"family":"neutral"},
    {"tokens":["accent","mdCode","mdListBullet","syntaxType"],"family":"violet"},
    {"tokens":["border","mdLink","syntaxKeyword"],"family":"blue"},
    {"tokens":["borderAccent","syntaxVariable"],"family":"cyan"},
    {"tokens":["borderMuted"],"family":"neutral"},
    {"tokens":["success","mdCodeBlock","toolDiffAdded","bashMode","syntaxNumber"],"family":"green"},
    {"tokens":["error","toolDiffRemoved"],"family":"red"},
    {"tokens":["warning","mdHeading"],"family":"yellow"},
    {"tokens":["syntaxFunction"],"family":"yellow"},
    {"tokens":["syntaxString"],"family":"orange"},
    {"tokens":["footerText","mdTableBorder"],"family":"neutral"},
    {"tokens":["toolArgument"],"family":"blue"},
    {"tokens":["thinkingOff"],"family":"neutral"},
    {"tokens":["thinkingMinimal"],"family":"thinkingSlate"},
    {"tokens":["thinkingLow"],"family":"thinkingBlue"},
    {"tokens":["thinkingMedium"],"family":"thinkingPeriwinkle"},
    {"tokens":["thinkingHigh"],"family":"thinkingViolet"},
    {"tokens":["thinkingXhigh"],"family":"thinkingMagenta"},
    {"tokens":["thinkingMax"],"family":"thinkingRed"}
  ]
}
